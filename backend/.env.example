NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nova_learn

# Admin authentication
ADMIN_USERNAME=admin
# Set ADMIN_PASSWORD_HASH with bcryptjs hash or implement a seed script.
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me
ADMIN_JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

