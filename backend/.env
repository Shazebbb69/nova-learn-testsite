NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nova_learn

ADMIN_USERNAME=admin
# NOTE: keep this empty until you set a real bcrypt hash. Use seed script later.
ADMIN_PASSWORD_HASH=
